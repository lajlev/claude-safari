{
  "manifest_version": 3,
  "name": "Send to Claude",
  "version": "1.0.0",
  "description": "Send the current page (or your selection) to Claude: a new chat or the conversation you have open, tiled next to Safari.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Send page to Claude",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "send-page": {
      "suggested_key": {
        "default": "Ctrl+E",
        "mac": "Command+E"
      },
      "description": "Send page to Claude (new chat)"
    },
    "add-to-chat": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Add page to the current Claude chat"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "claude-inject.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
